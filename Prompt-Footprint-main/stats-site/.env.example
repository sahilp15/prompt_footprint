# Dashboard (Vite) environment. Copy to stats-site/.env (gitignored).
#
# Both values are PUBLIC. The anon key is safe to expose because Supabase
# Row-Level Security restricts every row to its owner. Never put the
# service_role key here.
#
# The extension's primary auth path runs through the background worker
# (extension/lib/supabaseClient.js), so these are only needed if the dashboard
# itself ever reads Supabase directly. Kept here for parity and future use.

VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-publishable-key>

# ── Public marketing site (optional overrides) ──────────────────────────────
# These have sensible defaults in src/config/site.js; set them here only if you
# want to override without editing source. All are PUBLIC, non-secret values.
#
# VITE_SITE_URL=https://promptfootprint.app
# VITE_CHROME_STORE_URL=          # leave empty until the Web Store listing is live
# VITE_SUPPORT_EMAIL=support@promptfootprint.app
# VITE_LEGAL_EMAIL=legal@promptfootprint.app
# VITE_SECURITY_EMAIL=security@promptfootprint.app
