# Supabase admin / migration environment (LOCAL ONLY).
#
# Copy to supabase/.env and fill in. supabase/.env is gitignored and must NEVER
# be committed. These values are used only by local admin/migration scripts and
# the Supabase CLI — the browser extension never reads this file.
#
# The extension ships only SUPABASE_URL and the ANON key (both public, safe by
# RLS). The SERVICE_ROLE key below bypasses RLS and must stay off any client.

SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Public, shippable. Also set as VITE_SUPABASE_ANON_KEY in stats-site/.env and
# baked into extension/lib/supabaseClient.js.
SUPABASE_ANON_KEY=<your-anon-publishable-key>

# SECRET. Bypasses Row-Level Security. Local admin/migration use only.
SUPABASE_SERVICE_ROLE_KEY=

# For `supabase db push` against the hosted project.
SUPABASE_DB_PASSWORD=
