{
  "name": "PromptFootprint",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Visualize the environmental impact of every AI prompt — energy, water, and CO2",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://prod.spline.design/*",
    "https://*.workers.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https://prod.spline.design https://*.workers.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'none';"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
      "js": [
        "extension/lib/storage.js",
        "extension/lib/platforms.js",
        "extension/lib/constants.js",
        "extension/lib/tokenEstimator.js",
        "extension/lib/environmentalModel.js",
        "extension/lib/promptOptimizer.js",
        "extension/content.js"
      ],
      "css": [
        "extension/styles/fonts.css",
        "extension/overlay/floating.css",
        "extension/overlay/modal.css",
        "extension/overlay/optimizer.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_icon": {
      "48": "Images/PF_Icon.png",
      "128": "Images/PF_Icon.png"
    }
  },
  "options_page": "extension/dashboard/index.html",
  "icons": {
    "48": "Images/PF_Icon.png",
    "128": "Images/PF_Icon.png"
  }
}
